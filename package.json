{
  "name": "scanova",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Rebuild",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Target aab",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Target apk"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.27",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-image-manipulator": "~56.0.19",
    "expo-linking": "~56.0.14",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.11",
    "expo-sharing": "~56.0.18",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-mobile-ads": "^15.8.0",
    "react-native-pdf-to-image": "^4.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.15",
    "typescript": "~6.0.3"
  }
}

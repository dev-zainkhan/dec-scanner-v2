{
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "android": true,
    ".expo": true,
    ".build-cache": true
  },
  "search.exclude": {
    "android": true,
    "node_modules": true,
    ".build-cache": true
  },
  "files.watcherExclude": {
    "**/.build-cache/**": true,
    "**/android/**": true,
    "**/node_modules/**": true
  }
}
